type Query {
    account(accountNumber: ID!): AccountDetails
    accounts(accountNumbers: [ID!]!): [AccountDetails]
}

type AccountDetails {
    accountNumber: ID!
    accountName: String
    accountType: String
    currency: String
    status: String
    createdDate: String
    balance: BalanceDetails
    address: AddressDetails
}

type BalanceDetails {
    currency: String
    currentBalance: Float
    availableBalance: Float
    lastTransactionDate: String
}

type AddressDetails {
    street: String
    houseNumber: String
    city: String
    state: String
    postalCode: String
    country: String
    contact: ContactDetails
}

type ContactDetails {
    phone: String
    email: String
}
